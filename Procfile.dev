# All of Leadline locally, in one terminal: `make dev` (from leadline_backend).
# Postgres must already be running. Then open http://localhost:3000. Ctrl+C stops all.
#
# API on 8000, website on 3000, as in the .env files (API_URL, CORS_ALLOWED_ORIGINS,
# FRONTEND_URL). Stop other projects using those ports first.
api: python manage.py runserver 8000
temporal: python manage.py temporal_dev_server
worker: python manage.py temporal_worker --wait 60
ui: cd ../leadline-ui && pnpm dev
