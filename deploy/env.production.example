# The server's settings: copy to /srv/leadline/.env (chmod 600) and fill in.
# Only what differs from the defaults in .env.example is here. docker-compose.yml sets
# DB_HOST, REDIS_URL, TEMPORAL_ADDRESS and TRUSTED_CLIENT_IP_HEADER itself.

# Django. Generate the key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=leadline-api.digitalappex.co.ke,localhost
DJANGO_LOG_LEVEL=INFO

# PostgreSQL (the postgres container is created with these). openssl rand -hex 24
DB_NAME=leadline
DB_USER=leadline
DB_PASSWORD=
DB_CONN_MAX_AGE=60

# The UI on Vercel. Its server calls the API; the browser calls it directly only to
# send and fetch files (CORS).
FRONTEND_URL=https://leadline.digitalappex.co.ke
CORS_ALLOWED_ORIGINS=https://leadline.digitalappex.co.ke
CSRF_TRUSTED_ORIGINS=https://leadline.digitalappex.co.ke
# The same value as UI_PROXY_SECRET in Vercel's settings. openssl rand -hex 32
UI_PROXY_SECRET=

# Email: sign-up codes, invitations, reminders, the digest. Real SMTP is required.
# ZeptoMail (Zoho's transactional mail, as the Digital Appex site uses): the user is
# literally "emailapikey", the password is the Send Mail token (without the
# "Zoho-enczapikey " prefix), and the sender must be on its verified domain.
EMAIL_HOST=smtp.zeptomail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=emailapikey
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Leadline <noreply@digitalappex.co.ke>

# AI: the real agents.
DISCOVERY_RUNNER=graph
PROPOSAL_RUNNER=graph
AI_LLM_PROVIDER=groq
LIGHT_MODEL=openai/gpt-oss-20b
RESEARCH_MODEL=openai/gpt-oss-20b
ANSWER_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# Backup keys, used when the first key is rate-limited, used up or rejected.
GROQ_API_KEY_2=
AI_FALLBACK_PROVIDER=gemini
FALLBACK_LIGHT_MODEL=gemini-3.5-flash-lite
FALLBACK_RESEARCH_MODEL=gemini-3.5-flash-lite
FALLBACK_ANSWER_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# Emailed when the daily model check finds a broken key or a retired model.
AI_ALERT_EMAILS=
AI_HTTP_USER_AGENT=LeadlineBot/0.1 (+https://leadline.digitalappex.co.ke)

# Agent tools.
TAVILY_API_KEY=
JINA_API_KEY=
FIRECRAWL_API_KEY=
HUNTER_API_KEY=
PAGESPEED_API_KEY=
APIFY_API_TOKEN=
APIFY_GOOGLE_MAPS_ENABLED=False

# Optional tracing of agent runs.
LANGSMITH_TRACING=False
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=leadline
