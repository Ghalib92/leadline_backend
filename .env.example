# Copy to .env and fill in. Every value here is a safe local default unless marked.
# `python manage.py check` warns about broken values.

# Django. Use config.settings.production on servers.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_INTERNAL_IPS=127.0.0.1
# Production only:
# DJANGO_LOG_LEVEL=INFO
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# PostgreSQL with the pgvector extension (see README).

DB_NAME=leadline
DB_USER=leadline
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
# e.g. require on hosted databases; empty locally.
DB_SSLMODE=

# The frontend (leadline-ui) runs on :5173 with `pnpm dev`.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Temporal runs every background job (documents, the AI summary, searches, proposals,
# emails) and the timers (scheduled searches, deadline reminders). Locally, `make dev`
# starts a Temporal server and a worker; the Temporal UI is on http://localhost:8233.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=leadline
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=4

# API
API_PAGE_SIZE=25
REPORTING_MIN_COHORT_SIZE=3

# Auth
JWT_ACCESS_TOKEN_LIFETIME_DAYS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
OTP_EXPIRY_MINUTES=15
OTP_MAX_ATTEMPTS=5
LOGIN_THROTTLE_RATE=5/minute
REGISTRATION_THROTTLE_RATE=5/hour
OTP_THROTTLE_RATE=10/hour
JWT_REFRESH_COOKIE_NAME=leadline_refresh
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_DOMAIN=

# Used in emailed links (invitations, reminders) and calendar files.
FRONTEND_URL=http://localhost:5173
PRODUCT_NAME=Leadline
DEFAULT_FROM_EMAIL=Leadline <noreply@leadline.local>

# Email. Defaults to the console backend; for Gmail SMTP use smtp.gmail.com
# with a Google App Password.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10

# Organizations. The frontend must implement this route and read #token=... .
ORGANIZATION_INVITATION_PATH=/invitations/accept
ORGANIZATION_INVITATION_EXPIRY_HOURS=168
ORGANIZATION_INVITATION_RESEND_COOLDOWN_SECONDS=60
ORGANIZATION_CREATE_THROTTLE_RATE=10/hour
ORGANIZATION_INVITATION_THROTTLE_RATE=30/hour
ORGANIZATION_INVITATION_TOKEN_THROTTLE_RATE=60/hour
ORGANIZATION_DOCUMENT_THROTTLE_RATE=120/hour
ORGANIZATION_DOCUMENT_MAX_UPLOAD_MB=25

# AI agents. One model id per tier; ai/config/models.yaml maps agent roles to tiers.
AI_LLM_PROVIDER=groq
LIGHT_MODEL=openai/gpt-oss-20b
RESEARCH_MODEL=openai/gpt-oss-20b
ANSWER_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# Fallback when Groq is rate-limited or down (optional): the same call goes to Gemini.
# A free key from Google AI Studio. Leave AI_FALLBACK_PROVIDER empty for no fallback.
AI_FALLBACK_PROVIDER=
FALLBACK_LIGHT_MODEL=gemini-2.5-flash-lite
FALLBACK_RESEARCH_MODEL=gemini-2.5-flash
FALLBACK_ANSWER_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Company knowledge. Embeddings run locally with fastembed (the model, ~70 MB, downloads
# on first use into KNOWLEDGE_EMBEDDING_CACHE_DIR). Changing the model or dimensions needs
# a migration and `python manage.py knowledge_reprocess`.
KNOWLEDGE_EMBEDDING_PROVIDER=fastembed
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KNOWLEDGE_EMBEDDING_DIMENSIONS=384
KNOWLEDGE_EMBEDDING_CACHE_DIR=.cache/fastembed
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_MAX_DOCUMENT_CHARS=400000
KNOWLEDGE_PROCESSING_TIMEOUT_MINUTES=30
KNOWLEDGE_DOSSIER_DOCUMENT_CHARS=6000
KNOWLEDGE_DOSSIER_MAX_DOCUMENT_CHARS=40000
KNOWLEDGE_DOSSIER_DELAY_SECONDS=30
KNOWLEDGE_REFRESH_THROTTLE_RATE=30/hour

# Discovery runs. "graph" runs the real agents (needs GROQ_API_KEY, and TAVILY_API_KEY
# for web search); "fake" needs no keys and produces [Sample] opportunities, for
# offline work and tests. Set graph locally once you have the keys.
DISCOVERY_RUNNER=fake
DISCOVERY_FAKE_STEP_SECONDS=0.8
DISCOVERY_STALE_RUN_MINUTES=20
DISCOVERY_RUN_THROTTLE_RATE=20/hour
OPPORTUNITY_REVIEW_THROTTLE_RATE=300/hour

# Agent tools. Tavily's dev plan allows 100 requests/minute; stay below it.
TAVILY_API_KEY=
TAVILY_REQUESTS_PER_MINUTE=60
# Business search (Clients goal). OpenStreetMap needs no key. Google Maps through
# Apify uses your Apify credit and scrapes Google Maps (against Google's terms), so it
# stays off unless you turn it on.
APIFY_API_TOKEN=
APIFY_GOOGLE_MAPS_ENABLED=False
# Mobile speed of leads' websites (Google PageSpeed). Optional; a free key from Google
# Cloud (enable "PageSpeed Insights API"). Without it the speed check is skipped.
PAGESPEED_API_KEY=
# Reading leads' websites built by JavaScript or that refuse simple clients (optional).
# Jina Reader works without a key at a low rate; Firecrawl is a backup and uses credits.
JINA_API_KEY=
FIRECRAWL_API_KEY=
# Add your site once you have a domain: LeadlineBot/0.1 (+https://yourdomain.com).
# OpenStreetMap refuses placeholder domains such as example.com.
AI_HTTP_USER_AGENT=LeadlineBot/0.1
AI_HTTP_TIMEOUT_SECONDS=20
AI_FETCH_MAX_BYTES=2000000

# Optional LangSmith tracing of agent runs.
LANGSMITH_TRACING=False
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=leadline

# The Proposal Writer. "graph" uses the real agents (needs GROQ_API_KEY); "fake"
# writes sample text without any API calls.
PROPOSAL_RUNNER=fake
PROPOSAL_FAKE_STEP_SECONDS=0.5
PROPOSAL_STALE_MINUTES=20
PROPOSAL_JOB_THROTTLE_RATE=60/hour

# Leads, outreach and deadlines. HUNTER_API_KEY is optional. Emails are sent only when
# an admin approves them, with replies going to that admin.
HUNTER_API_KEY=
OUTREACH_DAILY_SEND_LIMIT=20
OUTREACH_REPEAT_DAYS=7
OUTREACH_JOB_STALE_MINUTES=10
OUTREACH_JOB_THROTTLE_RATE=60/hour
DEADLINE_REMINDER_DAYS=14,3,1
SCHEDULED_RUNS_ENABLED=True
DISCOVERY_SCHEDULE_BATCH=20
DISCOVERY_DISPATCH_ATTEMPTS=3

# Times Temporal runs a search whose worker died (each retry uses the budget left).
DISCOVERY_RUN_ATTEMPTS=2
